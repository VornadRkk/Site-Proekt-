# Install as /etc/dateandtime/api.env, owned by root, mode 600.
# This is a systemd EnvironmentFile, not a shell script. Do not add 'export'.
ConnectionStrings__MySql="Server=127.0.0.1;Port=3306;Database=dateandtime;User=dateandtime;Password=REPLACE_ME;"
# Use the actual MySQL version, for example 8.0.36 or 8.4.0.
Database__ServerVersion=8.0.36
Jwt__Key=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
Admin__Email=admin@example.com
Admin__Password=REPLACE_WITH_A_UNIQUE_STRONG_PASSWORD
